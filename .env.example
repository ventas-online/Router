# Copia este archivo a `.env` y pega las API keys que tengas.
# Cuantas más proveedores actives, mejor será el failover.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
HF_API_KEY=
ROUTER_PRIORITY=openrouter,cerebras,groq,gemini,mistral,huggingface
DAILY_LIMIT_OPENROUTER=0
DAILY_LIMIT_CEREBRAS=900000
DAILY_LIMIT_GROQ=0
DAILY_LIMIT_GEMINI=0
DAILY_LIMIT_MISTRAL=0
DAILY_LIMIT_HUGGINGFACE=0
ROUTER_COOLDOWN_SECONDS=300
ROUTER_FAILURE_THRESHOLD=3
